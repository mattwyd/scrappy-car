# Copy to .env and fill in. .env is gitignored. Same names are used for n8n
# credentials and Vercel env vars so there's one vocabulary across the stack.

# ── n8n / tunnel ────────────────────────────────────────────
N8N_HOST=localhost
N8N_WEBHOOK_HOST=hooks.scrappycar.ca
N8N_ENCRYPTION_KEY=              # openssl rand -hex 32, back this up: losing it loses all n8n credentials
CLOUDFLARE_TUNNEL_TOKEN=         # Zero Trust > Tunnels > create; public hostname hooks.scrappycar.ca → http://n8n:5678, path ^/webhook
HOOK_SECRET=                     # shared secret sent as X-Hook-Secret by Vercel functions and Clay

# ── Supabase (shared by scrappycar + carcash) ───────────────
SUPABASE_URL=
SUPABASE_SECRET_KEY=             # service role / secret key, server-side only
SUPABASE_DB_URL=                 # for pg_dump backups (W12)

# ── PostHog ─────────────────────────────────────────────────
POSTHOG_PROJECT_KEY=             # public phc_ key (already in carca.sh HTML)
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PERSONAL_API_KEY=        # for n8n reads (dashboards, insights)

# ── Twilio ──────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MAIN_NUMBER=+16472044200  # after port-in
TWILIO_ADS_NUMBER=
TWILIO_SOCIAL_NUMBER=
OWNER_PHONES=                    # comma-separated E.164, used for simultaneous ring + SMS commands

# ── Notifications ───────────────────────────────────────────
BEEPER_MATRIX_TOKEN=             # already used by carca.sh api/accept.js
BEEPER_MATRIX_ROOM=              # leads room
BEEPER_APPROVALS_ROOM=
BEEPER_OPS_ROOM=
TELEGRAM_BOT_TOKEN=              # driver UGC uploads (W13)

# ── AI ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=                  # W17 ChatGPT check + transcription fallback
PERPLEXITY_API_KEY=              # W17
GEMINI_API_KEY=                  # W17

# ── Google ──────────────────────────────────────────────────
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_PICKUP_CONVERSION_ACTION=
GOOGLE_OAUTH_CLIENT_ID=          # GBP, Search Console, Ads via n8n OAuth credential
GOOGLE_OAUTH_CLIENT_SECRET=
GBP_ACCOUNT_ID=
GBP_LOCATION_ID=
GSC_SITE_URL=sc-domain:scrappycar.ca

# ── Outreach / SEO ──────────────────────────────────────────
CLAY_WEBHOOK_SECRET=
SERPAPI_KEY=
OUTREACH_GMAIL_ADDRESS=

# ── Social ──────────────────────────────────────────────────
POSTIZ_URL=http://postiz:5000
POSTIZ_API_KEY=

# ── GitHub (W18 location page PRs) ──────────────────────────
GITHUB_TOKEN=                    # fine-grained, contents + pull requests on mattwyd/scrappy-car only
